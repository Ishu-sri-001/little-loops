# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Sender. Must use a domain you've verified in Resend (https://resend.com/domains).
# For quick local testing before verifying, you can use: Little Loops <onboarding@resend.dev>
RESEND_FROM_EMAIL="Little Loops <hello@yourdomain.com>"

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=hello@yourdomain.com

# Optional: segment to add newsletter subscribers to: https://resend.com/audience
RESEND_SEGMENT_ID=

# Public URL of the live site, used for canonical links and social share previews
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
